{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mk-josias/laravel-skeleton",
    "type": "project",
    "description": "Application skeleton for laravel-distributable-modules: a modular monolith deployable as one process or as per-module services.",
    "keywords": ["laravel", "modular-monolith", "distributable", "skeleton"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "firebase/php-jwt": "^7.0",
        "laravel/framework": "^13.8",
        "laravel/octane": "^2.20",
        "laravel/reverb": "^1.12",
        "laravel/tinker": "^3.0",
        "mk-josias/laravel-distributable-modules": "^0.1",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-query-builder": "^6.0 || ^7.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.12",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Foundation\\": "foundation/",
            "Apps\\Iam\\": "apps/Iam/app/",
            "Apps\\Iam\\Database\\Factories\\": "apps/Iam/database/factories/",
            "Apps\\Iam\\Database\\Seeders\\": "apps/Iam/database/seeders/",
            "Apps\\Analytics\\": "apps/Analytics/app/",
            "Apps\\Analytics\\Database\\Factories\\": "apps/Analytics/database/factories/",
            "Apps\\Analytics\\Database\\Seeders\\": "apps/Analytics/database/seeders/",
            "Apps\\Notifications\\": "apps/Notifications/app/",
            "Apps\\Notifications\\Database\\Factories\\": "apps/Notifications/database/factories/",
            "Apps\\Notifications\\Database\\Seeders\\": "apps/Notifications/database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Apps\\Iam\\Tests\\": "apps/Iam/tests/",
            "Apps\\Analytics\\Tests\\": "apps/Analytics/tests/",
            "Apps\\Notifications\\Tests\\": "apps/Notifications/tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan auth:jwt-keys",
            "@php artisan migrate --force",
            "@php artisan iam:sync-permissions --prune"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan serve"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "check": [
            "pint --test",
            "phpstan analyse --memory-limit=1G",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan auth:jwt-keys --ansi",
            "@php artisan skeleton:setup --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi",
            "@php artisan iam:sync-permissions --prune --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": ["apps/*/composer.json"]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": {
        "framework": {
            "type": "path",
            "url": "../modular-monolith",
            "options": {
                "symlink": true,
                "versions": {
                    "mk-josias/laravel-distributable-modules": "0.1.0"
                }
            }
        },
        "microservices": {
            "type": "path",
            "url": "../laravel-microservices",
            "options": {
                "symlink": true,
                "versions": {
                    "mk-josias/laravel-microservices": "0.1.0"
                }
            }
        }
    }
}
